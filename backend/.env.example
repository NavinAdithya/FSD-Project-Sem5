# Server Port (default: 4000)
PORT=4000

# JSON Web Token Secret Key — MUST be changed to a cryptographically strong random string in production
JWT_SECRET=change-this-secret-to-a-secure-random-key-in-production

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS client origin (optional in dev, recommended in production)
# CLIENT_URL=https://navinadithya.github.io
